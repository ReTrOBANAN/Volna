# Скопируйте в .env. Замените ключ: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=replace-with-a-random-generated-secret
# Только локальная разработка. Для любого публичного сервера: False.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Novosibirsk
MAX_UPLOAD_MB=100
# Для HTTPS-развёртывания включите secure cookies и перенаправление на HTTPS.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_COOKIES=False
